# PostgreSQL
LEDGER_DB_DATA_DIR=./data/database/local-docker-build
LEDGER_DB_NAME=ledger
LEDGER_DB_USERNAME=ledger
LEDGER_DB_PASSWORD=ledger

# Published host ports
LEDGER_SERVER_PORT=8080
LEDGER_CLIENT_PORT=4200

# Initial Ledger administrator
LEDGER_BOOTSTRAP_ADMIN_USERNAME=ledger-admin
LEDGER_BOOTSTRAP_ADMIN_PASSWORD=ledger
LEDGER_BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin
LEDGER_BOOTSTRAP_ADMIN_ROLES=ROLE_ADMIN,ROLE_STAFF

LEDGER_JWT_SECRET=change-me-only-for-local-docker-build
LEDGER_ACCESS_TOKEN_SECONDS=900
