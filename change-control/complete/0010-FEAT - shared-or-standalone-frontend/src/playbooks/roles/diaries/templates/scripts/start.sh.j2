#!/bin/bash

set -euo pipefail

PROJECT_DIR="{{ diaries_project_dir }}"
COMPOSE_FILE="${PROJECT_DIR}/compose.yaml"
ENV_FILE="${PROJECT_DIR}/.env"
FRONTEND_MODE="{{ diaries_frontend_mode }}"

cd "${PROJECT_DIR}"

if [[ "${FRONTEND_MODE}" == "shared" ]]; then
    if ! docker network inspect "{{ diaries_shared_network_name }}" >/dev/null 2>&1; then
        echo "ERROR: Shared Docker network '{{ diaries_shared_network_name }}' does not exist." >&2
        echo "Start/install the infrastructure stack first." >&2
        exit 1
    fi

    if ! docker inspect "{{ diaries_shared_frontend_nginx_container_name }}" >/dev/null 2>&1; then
        echo "ERROR: Shared Nginx container '{{ diaries_shared_frontend_nginx_container_name }}' does not exist." >&2
        echo "Start/install the infrastructure stack first." >&2
        exit 1
    fi
fi

docker compose \
    --file "${COMPOSE_FILE}" \
    --env-file "${ENV_FILE}" \
    config --quiet

docker compose \
    --file "${COMPOSE_FILE}" \
    --env-file "${ENV_FILE}" \
    up -d
