# Diaries routes for a shared infrastructure Nginx container.
#
# Docker service names are deliberately resolved at request time through
# Docker's embedded DNS server. This allows infra-nginx to start/reload even
# while the Diaries stack is stopped or is still starting after a reboot.
resolver 127.0.0.11 valid=30s ipv6=off;

location /diaries/ {
    set $diaries_client_upstream http://diaries-client:8080;
    proxy_pass $diaries_client_upstream;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port  $server_port;
}

location /diaries-responder/ {
    rewrite ^/diaries-responder/(.*)$ /$1 break;
    set $diaries_responder_upstream http://diaries-responder:8081;
    proxy_pass $diaries_responder_upstream;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port  $server_port;
}

location /mosquitto {
    set $diaries_mqtt_upstream http://diaries-mqtt:9001;
    proxy_pass $diaries_mqtt_upstream;

    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    proxy_set_header Host              $host;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
