20:13:19.375 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise -          value: {"id":1058,"version":0,"year":1830,"month":9,"day":5,"sequence":1.0000,"text":"<p>A dull morning. Wind WNW. Walked to Tynemouth. Attended morning service with the military. Dined at home. Drury &amp; Sadler dined with me. H Harry came in afterwards. At the Mulstrum in the evening.</p>","pageId":846,"type":"MARQUEE","imageId":null,"marqueeId":1006,"lock":null}
20:13:19.375 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise - Difference detected on topic: diaries/dates/1830/9/6/1059
20:13:19.375 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise -           DB:   {"id":1059,"version":0,"year":1830,"month":9,"day":6,"sequence":1.0000,"text":"<p>A dull morning. Wind east. Turned out a very fine day. H French &amp; I walked to Tynemouth. Dined at home. At the Albion in the afternoon. Drank tea with H Harry &amp; again at the Albion in the evening.</p>","pageId":847,"type":"MARQUEE","imageId":null,"marqueeId":1007,"lock":null}
20:13:19.375 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise -           Tree: null
20:13:19.376 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise - publish: topic: diaries/dates/1830/9/6/1059
20:13:19.376 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise -          value: {"id":1059,"version":0,"year":1830,"month":9,"day":6,"sequence":1.0000,"text":"<p>A dull morning. Wind east. Turned out a very fine day. H French &amp; I walked to Tynemouth. Dined at home. At the Albion in the afternoon. Drank tea with H Harry &amp; again at the Albion in the evening.</p>","pageId":847,"type":"MARQUEE","imageId":null,"marqueeId":1007,"lock":null}
20:13:19.376 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise - Difference detected on topic: diaries/dates/1830/9/7/1060
20:13:19.376 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise -           DB:   {"id":1060,"version":0,"year":1830,"month":9,"day":7,"sequence":1.0000,"text":"<p>A rainy morning, blowing hard from the NE with a sea upon the bar. Walked to Tynemouth. Dined at home.</p>","pageId":847,"type":"MARQUEE","imageId":null,"marqueeId":1008,"lock":null}
20:13:19.376 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise -           Tree: null
20:13:19.376 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise - publish: topic: diaries/dates/1830/9/7/1060
20:13:19.376 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise -          value: {"id":1060,"version":0,"year":1830,"month":9,"day":7,"sequence":1.0000,"text":"<p>A rainy morning, blowing hard from the NE with a sea upon the bar. Walked to Tynemouth. Dined at home.</p>","pageId":847,"type":"MARQUEE","imageId":null,"marqueeId":1008,"lock":null}
20:13:19.376 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise - Difference detected on topic: diaries/dates/1830/9/8/1061
20:13:19.376 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise -           DB:   {"id":1061,"version":0,"year":1830,"month":9,"day":8,"sequence":1.0000,"text":"<p>A beautiful day. Wind ENE.  Went by coach to Newcastle to meet Dixon, but did not settle with him. Took the steam boat &amp; landed at Walker. Saw Mrs Carr &amp; child. Dined with them &amp; returned to Shields by steam. In the evening at the Mulstrum.</p>","pageId":847,"type":"MARQUEE","imageId":null,"marqueeId":1009,"lock":null}
20:13:19.376 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise -           Tree: null
20:13:19.376 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise - publish: topic: diaries/dates/1830/9/8/1061
20:13:19.376 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise -          value: {"id":1061,"version":0,"year":1830,"month":9,"day":8,"sequence":1.0000,"text":"<p>A beautiful day. Wind ENE.  Went by coach to Newcastle to meet Dixon, but did not settle with him. Took the steam boat &amp; landed at Walker. Saw Mrs Carr &amp; child. Dined with them &amp; returned to Shields by steam. In the evening at the Mulstrum.</p>","pageId":847,"type":"MARQUEE","imageId":null,"marqueeId":1009,"lock":null}
20:13:19.377 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise - Difference detected on topic: diaries/dates/1830/9/9/1062
20:13:19.377 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise -           DB:   {"id":1062,"version":0,"year":1830,"month":9,"day":9,"sequence":1.0000,"text":"<p>A wet morning. Wind SSW. A great many ships got to sea. Dreadful weather for the farmers, being heavy all day. Harry Cunningham &amp; I after dinner went to the George &amp; enjoyed ourselves over a jug or two of punch &amp; oysters. Called in at the Mulstrum.</p>","pageId":847,"type":"MARQUEE","imageId":null,"marqueeId":1010,"lock":null}
20:13:19.377 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise -           Tree: null
