20:13:21.615 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise -          value: {"id":1706,"version":0,"year":1832,"month":5,"day":20,"sequence":1.0000,"text":"<p>A beautiful morning. Wind SW &amp; SE. Walked up to Benton &amp; spent the day</p>","pageId":1000,"type":"MARQUEE","imageId":null,"marqueeId":1650,"lock":null}
