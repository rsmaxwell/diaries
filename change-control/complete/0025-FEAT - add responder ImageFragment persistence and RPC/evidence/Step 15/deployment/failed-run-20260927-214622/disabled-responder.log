20:13:19.624 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise -          value: {"id":1843,"version":0,"year":1832,"month":10,"day":10,"sequence":1.0000,"text":"<p>A beautiful morning wind NW. Walked to Tynemouth &amp; thence to Cullercoats &amp; dined with Boswell. Walked home in the evening. A very wet night.</p>","pageId":1020,"type":"MARQUEE","imageId":null,"marqueeId":1786,"lock":null}
20:13:19.624 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise - Difference detected on topic: diaries/dates/1832/10/11/1844
20:13:19.624 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise -           DB:   {"id":1844,"version":0,"year":1832,"month":10,"day":11,"sequence":1.0000,"text":"<p>A dull morning after having been raining all night. Wind WNW. Walked to Tynemouth. Dined at 4 o'clock at the George being Mr Ward's opening dinner. With Bess in the evening</p>","pageId":1020,"type":"MARQUEE","imageId":null,"marqueeId":1787,"lock":null}
