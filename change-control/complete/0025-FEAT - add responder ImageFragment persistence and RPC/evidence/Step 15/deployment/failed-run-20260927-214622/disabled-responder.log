20:13:22.155 [main] INFO  com.rsmaxwell.diaries.responder.sync.Synchronise -           DB:   {"id":720,"version":0,"year":1829,"month":10,"day":10,"sequence":1.0000,"text":"<figure>\r\n  <a href=\"https://www.burnhopeside-hall.co.uk/\" >\r\n    <img src=\"images/img2926-burnhopeside-hall.jpg\" width=\"600px\" />\r\n    <figcaption>Burnhopeside Hall</figcaption>\r\n  </a>\r\n</figure>","pageId":null,"type":null,"imageId":null,"marqueeId":null,"lock":null}
