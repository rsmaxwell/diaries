# Machine-local overrides shared by all three local Diaries modes.
#
# Copy this file to local.env. The scripts load the mode-specific environment
# first and local.env second, so values here take precedence.
#
# Using one PostgreSQL data directory means development-infrastructure,
# local-docker-build, and local-published-smoke see the same Diaries database.
# Run only one of those modes at a time.
#
# Replace MQTT password placeholders only in the ignored local.env file. The
# health password must match the diaries-health entry in
# %USERPROFILE%\.diaries\pwfile.source.txt.
#
# The Docker responder configuration is also machine-local. Its MQTT password
# must match the diaries-responder entry in the external password source.

DIARIES_DB_DATA_DIR=./data/database/common

DIARIES_MQTT_HEALTH_USERNAME=diaries-health
DIARIES_MQTT_HEALTH_PASSWORD=<local-diaries-health-password>

DIARIES_WEB_MQTT_USERNAME=diaries-web
DIARIES_WEB_MQTT_PASSWORD=<local-diaries-web-password>

# Override only when using a machine-specific web configuration.
DIARIES_WEB_DOCKER_CONFIG_FILE=./diaries-web/config/diaries-web.docker.json

# Use an absolute path. Docker Compose does not recursively expand variables
# contained inside values loaded from an --env-file.
DIARIES_RESPONDER_DOCKER_CONFIG_FILE=C:/Users/<username>/.diaries/responder.docker.json
